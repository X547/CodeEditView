// Resources of the CodeEdit application: its signature, launch behavior,
// the file types it opens (Tracker's "Open with" and preferred application)
// and the icons of the tool bar. Added to the built executable and again to
// the installed one by the install script.

resource app_signature "application/x-vnd.CodeEdit";

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "CodeEdit",
	long_info = "CodeEdit: source code editor, debugger and coverage viewer"
};

// Opening files again while running sends them to the running instance
// (B_REFS_RECEIVED, B_ARGV_RECEIVED).
resource app_flags B_SINGLE_LAUNCH;

resource file_types message {
	"types" = "text/plain",
	"types" = "text/x-source-code",
	"types" = "text/x-makefile",
	"types" = "text/x-jamfile",
	"types" = "text/x-patch",
	"types" = "text/x-vnd.be.resourcedef",
	"types" = "text/markdown",
	"types" = "text/css",
	"types" = "text/csv",
	"types" = "text/xml",
	"types" = "text/html",
	"types" = "application/json",
	"types" = "application/x-shellscript",
	// Any other text.
	"types" = "text"
};

// Tool bar icons, from the ToolBar demo. Loaded by name.
resource(101, "new") #'VICN' import "icons/new.hvif";
resource(102, "open") #'VICN' import "icons/open.hvif";
resource(103, "save") #'VICN' import "icons/save.hvif";
resource(104, "functions") #'VICN' import "icons/functions.hvif";
resource(105, "headers") #'VICN' import "icons/headers.hvif";
resource(106, "find") #'VICN' import "icons/find.hvif";
resource(107, "find-again") #'VICN' import "icons/find-again.hvif";
resource(108, "lock") #'VICN' import "icons/lock.hvif";
resource(109, "documents") #'VICN' import "icons/documents.hvif";
resource(110, "outline") #'VICN' import "icons/outline.hvif";
